# 复制本文件为 .env，填入真实信息后再构建。
# .env 已被 .gitignore 忽略；不要把真实信息写进本文件或提交到远端。
AUTHOR_NAME=你的名字
CONTACT_EMAIL=you@example.com
GITHUB_USER=your-github-username
GITHUB_REPO=your-repo-name
SITE_TITLE=我的成长主页
SITE_SUBTITLE=个人学习记录与项目实践
SCHOOL=你的学校
MAJOR=你的专业
GRADE=大一
LAST_UPDATED=2026-11-23

# 可选：已部署的 GitHub Pages 地址；未部署留空。
PAGES_URL=
# 可选：仓库地址；留空时按 GITHUB_USER/GITHUB_REPO 自动生成。
REPO_URL=
